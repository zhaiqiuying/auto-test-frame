<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle 规则 — Layer 1 静态分析
  检查范围：命名规范、import 顺序、代码风格、方法长度
  原则：只报确定性问题，不报风格偏好争议
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java, properties, xml"/>

  <!-- 文件级检查 -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
    <message key="containsTab" value="行包含 Tab 字符，应使用空格缩进"/>
  </module>
  <module name="LineLength">
    <property name="max" value="150"/>
    <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    <message key="maxLineLen" value="行长度超过 150 字符"/>
  </module>

  <module name="TreeWalker">
    <!-- 命名规范 -->
    <module name="TypeName">
      <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="类型名 ''{0}'' 不符合 PascalCase 规范"/>
    </module>
    <module name="ConstantName">
      <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
      <message key="name.invalidPattern" value="常量名 ''{0}'' 应为 UPPER_SNAKE_CASE"/>
    </module>
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="方法名 ''{0}'' 不符合 camelCase 规范"/>
    </module>
    <module name="MemberName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="成员变量名 ''{0}'' 不符合 camelCase 规范"/>
    </module>
    <module name="ParameterName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="参数名 ''{0}'' 不符合 camelCase 规范"/>
    </module>
    <module name="LocalVariableName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="局部变量名 ''{0}'' 不符合 camelCase 规范"/>
    </module>
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
      <message key="name.invalidPattern" value="包名 ''{0}'' 应全小写"/>
    </module>

    <!-- Import 检查 -->
    <module name="AvoidStarImport">
      <message key="import.avoidStar" value="避免使用通配符 import: {0}"/>
    </module>
    <module name="UnusedImports">
      <message key="import.unused" value="未使用的 import: {0}"/>
    </module>
    <module name="RedundantImport">
      <message key="import.redundant" value="冗余 import（同包）: {0}"/>
    </module>

    <!-- 代码结构 -->
    <module name="MethodLength">
      <property name="max" value="80"/>
      <property name="countEmpty" value="false"/>
      <message key="maxLen.method" value="方法长度超过 80 行"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="7"/>
      <message key="maxParam" value="方法参数超过 7 个"/>
    </module>
    <module name="EmptyBlock">
      <property name="tokens" value="LITERAL_WHILE, LITERAL_IF, LITERAL_FOR, LITERAL_ELSE, LITERAL_TRY, LITERAL_CATCH"/>
      <message key="block.empty" value="空代码块: {0}"/>
    </module>
    <module name="EmptyCatchBlock">
      <message key="catch.block.empty" value="空 catch 块，至少应有注释说明为何忽略异常"/>
    </module>
    <module name="EqualsHashCode">
      <message key="equals.hashCode" value="重写了 equals() 必须重写 hashCode()"/>
    </module>

    <!-- 代码质量 -->
    <module name="SimplifyBooleanExpression">
      <message key="simplify.expression" value="布尔表达式可简化: {0}"/>
    </module>
    <module name="SimplifyBooleanReturn">
      <message key="simplify.return" value="布尔返回可简化为直接返回表达式"/>
    </module>
    <module name="StringLiteralEquality">
      <message key="string.literal.equality" value="字符串比较应使用 equals() 而非 =="/>
    </module>
  </module>
</module>
