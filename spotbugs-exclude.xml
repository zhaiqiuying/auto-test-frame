<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs 排除规则 — Layer 1 静态分析
  此文件列出已知历史问题，后续逐个修复后从排除列表移除。
  新代码不允许新增这些类型的 bug。
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

  <!-- WEAK_MESSAGE_DIGEST_MD5: DataSourceFactory 使用 MD5 做配置缓存 key，非安全用途 -->
  <Match>
    <Class name="com.example.qa.btest.db.DataSourceFactory"/>
    <Bug pattern="WEAK_MESSAGE_DIGEST_MD5"/>
  </Match>

  <!-- WEAK_MESSAGE_DIGEST_MD5: RetryAnalyzer 使用 MD5 做注解 hash，非安全用途 -->
  <Match>
    <Class name="com.example.qa.btest.engine.listener.RetryAnalyzer"/>
    <Bug pattern="WEAK_MESSAGE_DIGEST_MD5"/>
  </Match>

  <!-- WEAK_MESSAGE_DIGEST_MD5: HttpModelUtil 使用 MD5 做请求指纹，非安全用途 -->
  <Match>
    <Class name="com.example.qa.itest.util.HttpModelUtil"/>
    <Bug pattern="WEAK_MESSAGE_DIGEST_MD5"/>
  </Match>

  <!-- MS_SHOULD_BE_FINAL: MethodBasedAssert.threadLocalMsg 需要可变，暂不 final -->
  <Match>
    <Class name="com.example.qa.btest.engine.asserts.MethodBasedAssert"/>
    <Bug pattern="MS_SHOULD_BE_FINAL"/>
  </Match>

  <!-- MS_SHOULD_BE_FINAL: ReceiverManager.receiverList 需要可变，暂不 final -->
  <Match>
    <Class name="com.example.qa.btest.engine.monitor.api.ReceiverManager"/>
    <Bug pattern="MS_SHOULD_BE_FINAL"/>
  </Match>

  <!-- NM_SAME_SIMPLE_NAME_AS_SUPERCLASS: MethodContext 遮蔽父类名，后续重构改名 -->
  <Match>
    <Class name="com.example.qa.btest.engine.dataProvider.common.MethodContext"/>
    <Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS"/>
  </Match>

  <!-- DM_DEFAULT_ENCODING: CsvDataProvider/CsvUtil 依赖默认编码，后续指定 UTF-8 -->
  <Match>
    <Bug pattern="DM_DEFAULT_ENCODING"/>
  </Match>

  <!-- DMI_INVOKING_TOSTRING_ON_ARRAY: RetryAnalyzer 对 Method.getParameters() 调 toString -->
  <Match>
    <Class name="com.example.qa.btest.engine.listener.RetryAnalyzer"/>
    <Bug pattern="DMI_INVOKING_TOSTRING_ON_ARRAY"/>
  </Match>

  <!-- STCAL_*: TimeUtil 静态 Calendar/DateFormat 线程不安全，后续重构 -->
  <Match>
    <Class name="com.example.qa.btest.util.TimeUtil"/>
    <Bug pattern="STCAL_INVOKE_ON_STATIC_DATE_FORMAT_INSTANCE"/>
  </Match>
  <Match>
    <Class name="com.example.qa.btest.util.TimeUtil"/>
    <Bug pattern="STCAL_STATIC_CALENDAR_INSTANCE"/>
  </Match>
  <Match>
    <Class name="com.example.qa.btest.util.TimeUtil"/>
    <Bug pattern="STCAL_STATIC_SIMPLE_DATE_FORMAT_INSTANCE"/>
  </Match>

</FindBugsFilter>
