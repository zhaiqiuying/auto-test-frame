<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.example.qa.auto-test</groupId>
        <artifactId>auto-test-frame</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.qa.auto-test</groupId>
    <artifactId>itest</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <jedis.version>4.4.3</jedis.version>
        <jedis-mock.version>1.1.21</jedis-mock.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example.qa.auto-test</groupId>
            <artifactId>btest</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 显式声明 Jedis 版本，避免 test-data-provider 传递依赖引入旧版 jedis 3.x -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
        </dependency>
        <!-- Redis Mock（仅测试用，纯 Java 实现，跨平台） -->
        <dependency>
            <groupId>com.github.fppt</groupId>
            <artifactId>jedis-mock</artifactId>
            <version>${jedis-mock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>true</filtering>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>